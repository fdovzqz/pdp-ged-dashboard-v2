# Copiar a .env.local en la raíz del proyecto.

# AWS (requerido para download scripts)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# CloudWatch Log Groups
CLOUDWATCH_LOG_GROUP_V1=/aws/vendedlogs/states/ReconciliationProcessAndConfirmationStateMachineLogs/master
CLOUDWATCH_LOG_GROUP_V2=/aws/vendedlogs/states/ReconciliationProcessAndConfirmationStateMachineV2Logs/master
CLOUDWATCH_LOG_GROUP_PAYMENT=/aws/vendedlogs/states/PaymentProcessStateMachineLogs/master

# Convex (desarrollo local)
# Ejecutar npx convex dev desde la raíz y copiar la URL
CONVEX_DEPLOYMENT=dev:xxx
CONVEX_URL=https://xxx.convex.cloud
NEXT_PUBLIC_CONVEX_URL=https://xxx.convex.cloud

# Convex en Vercel (producción): NO uses CONVEX_DEPLOYMENT ni NEXT_PUBLIC_CONVEX_URL aquí.
# En Vercel → Environment Variables (solo Production) pon CONVEX_DEPLOY_KEY con la
# Production Deploy Key del Dashboard de Convex. El build inyecta la URL automáticamente.
# Ver docs/production-setup.md

# DynamoDB (reconciliación datamappings - backup Prod)
DYNAMODB_DATAMAPPING_TABLE=datamappingtable-master-restored-4-feb-2026

# Variables para Convex Actions (configurar en Convex Dashboard > Settings > Environment Variables):
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION
# CLOUDWATCH_LOG_GROUP_V1, CLOUDWATCH_LOG_GROUP_V2, CLOUDWATCH_LOG_GROUP_PAYMENT
# DYNAMODB_DATAMAPPING_TABLE

# Inngest (producción en Vercel): INNGEST_SIGNING_KEY e INNGEST_EVENT_KEY las añade
# la integración Inngest ↔ Vercel. Ver docs/production-setup.md y docs/inngest-setup.md
